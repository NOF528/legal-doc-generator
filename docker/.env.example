# 法律文档生成器 - 环境变量配置
# 复制此文件为 .env 并修改配置

# ==================== 基础配置 ====================
ENV=production
DEBUG=false
PROJECT_NAME=legal-doc-generator

# ==================== 安全配置 ====================
# 访问密码（设置后所有用户需要输入密码）
# 留空则不启用密码保护
ACCESS_PASSWORD=

# ==================== 后端配置 ====================
# 监听地址
HOST=0.0.0.0
PORT=8000

# 工作进程数（建议：CPU核心数 + 1）
WORKERS=2

# ==================== 文件上传配置 ====================
# 最大上传文件大小（MB）
MAX_UPLOAD_SIZE=50

# 上传文件保留时间（分钟），0表示立即删除
UPLOAD_RETENTION_MINUTES=0

# ==================== 日志配置 ====================
# 日志级别：DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ==================== 可选：外部服务 ====================
# 如需使用外部存储（阿里云OSS/AWS S3），配置此处
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET_NAME=
# OSS_ENDPOINT=

# ==================== 可选：数据库 ====================
# 如需用户系统，配置数据库连接
# DATABASE_URL=postgresql://user:password@db:5432/legaldoc

# ==================== 可选：Redis ====================
# 如需缓存或队列，配置Redis连接
# REDIS_URL=redis://redis:6379/0
