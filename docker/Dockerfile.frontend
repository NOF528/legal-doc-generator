# 前端服务镜像 - 独立构建，可单独升级
FROM node:20-alpine AS builder

WORKDIR /app

# 复制依赖文件
COPY frontend/my-app/package*.json ./
RUN npm ci --only=production

# 复制源码并构建
COPY frontend/my-app/ ./
RUN npm run build

# 生产环境镜像
FROM node:20-alpine

WORKDIR /app

# 安装serve工具
RUN npm install -g serve

# 从builder复制构建产物
COPY --from=builder /app/dist ./dist

# 暴露端口
EXPOSE 3000

# 启动命令
CMD ["serve", "-s", "dist", "-l", "3000"]
